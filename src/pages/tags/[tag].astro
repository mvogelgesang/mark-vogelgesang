---
import { getCollection } from "astro:content";
import PageWrapper from "../../layouts/PageWrapper.astro";
import MaterialIcon from "../../components/MaterialIcon.astro";
import PostRow from "../../components/PostRow.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { formatDate } from "../../utils/posts";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags.includes(tag))
      .sort(
        (a, b) =>
          new Date(b.data.pubDate).valueOf() -
          new Date(a.data.pubDate).valueOf()
      );
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<PageWrapper title={tag}>
  <div class="w-full">
    <header class="page-header">
      <a class="breadcrumb font-sans" href="/tags">
        <MaterialIcon class="breadcrumb-icon" iconName="arrow_back" />
        All topics
      </a>
      <SectionTitle as="h1" class="topic-title">{tag}</SectionTitle>
      <p class="page-subtitle font-sans text-text">
        {posts.length} {posts.length === 1 ? "post" : "posts"} tagged with
        “{tag}”.
      </p>
    </header>

    <div class="post-list">
      {
        posts.map((post) => (
          <PostRow
            url={`/blog/${post.slug}`}
            title={post.data.title}
            description={post.data.description}
            date={formatDate(post.data.pubDate)}
          />
        ))
      }
    </div>
  </div>
</PageWrapper>

<style>
  .page-header {
    margin: 2.5rem 0 1.5rem;
  }
  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: hsl(var(--color-secondary));
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .breadcrumb:hover {
    color: hsl(var(--color-primary));
    text-decoration: underline;
  }
  .breadcrumb-icon {
    font-size: 1.1em;
  }
  .topic-title {
    text-transform: lowercase;
  }
  .page-subtitle {
    font-size: 1.05rem;
    margin: 0;
    padding: 0;
  }
  .post-list {
    margin-bottom: 3rem;
  }
</style>
