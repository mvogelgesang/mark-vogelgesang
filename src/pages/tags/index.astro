---
import { getCollection } from "astro:content";
import PageWrapper from "../../layouts/PageWrapper.astro";
import Chip from "../../components/Chip.astro";
import SectionTitle from "../../components/SectionTitle.astro";

const allPosts = await getCollection("blog");

const tagCounts = new Map();
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const sortedTags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].toLowerCase().localeCompare(b[0].toLowerCase())
);
---

<PageWrapper title="Topics">
  <div class="w-full">
    <header class="page-header">
      <SectionTitle as="h1">Browse by topic</SectionTitle>
      <p class="page-subtitle font-sans text-text">
        {sortedTags.length} topics across {allPosts.length} posts.
      </p>
    </header>

    <div class="chip-row">
      {
        sortedTags.map(([tag, count]) => (
          <Chip href={`/tags/${tag}/`} icon="tag">
            {tag} · {count}
          </Chip>
        ))
      }
    </div>
  </div>
</PageWrapper>

<style>
  .page-header {
    margin: 2.5rem 0 0.5rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    margin: 0;
    padding: 0;
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.25rem 0 3rem;
  }
</style>
