---
import { getCollection } from "astro:content";
import PageWrapper from "../layouts/PageWrapper.astro";
import Chip from "../components/Chip.astro";
import MaterialIcon from "../components/MaterialIcon.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { formatDate } from "../utils/posts";

// Use getCollection to fetch all posts, and then sort them by date.
const posts = (await getCollection("blog")).sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const tagCounts = new Map();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const sortedTags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].toLowerCase().localeCompare(b[0].toLowerCase())
);
---

<PageWrapper title="Posts">
  <div class="w-full">
    <header class="page-header">
      <SectionTitle as="h1">All posts</SectionTitle>
      <p class="page-subtitle font-sans text-text">
        {posts.length} posts, newest first.
      </p>
    </header>

    <div class="blog-layout">
      <aside class="topics-rail">
        <p class="rail-label font-sans">Topics</p>
        <div class="rail-chips">
          {
            sortedTags.map(([tag, count]) => (
              <Chip href={`/tags/${tag}/`} icon="tag">
                {tag} · {count}
              </Chip>
            ))
          }
        </div>
      </aside>

      <div class="post-list">
        {
          posts.map((post) => (
            <article class="post-row">
              <p class="post-row-date font-sans">
                {formatDate(post.data.pubDate)}
              </p>
              <h2 class="post-row-title font-header">
                <a
                  href={
                    post.data.externalUrl
                      ? post.data.externalUrl
                      : `/blog/${post.slug}`
                  }
                >
                  {post.data.title}
                  {post.data.externalUrl && (
                    <MaterialIcon
                      class="post-row-external"
                      iconName="open_in_new"
                    />
                  )}
                </a>
              </h2>
              <p class="post-row-desc font-sans">{post.data.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</PageWrapper>

<style>
  .page-header {
    margin: 2.5rem 0 1.5rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    margin: 0;
    padding: 0;
  }

  .blog-layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  .topics-rail {
    order: 2;
  }
  @media (min-width: 768px) {
    .blog-layout {
      display: grid;
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 3rem;
    }
    .topics-rail {
      order: 0;
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
  }

  .rail-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--color-secondary));
    margin: 0 0 0.75rem;
    padding: 0;
  }
  .rail-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-row {
    padding: 1.25rem 0;
    border-bottom: 1px solid hsl(var(--color-text) / 0.12);
  }
  .post-row:first-child {
    padding-top: 0;
  }
  .post-row-date {
    font-size: 0.85rem;
    color: hsl(var(--color-text) / 0.65);
    margin: 0 0 0.35rem;
    padding: 0;
  }
  .post-row-title {
    font-size: 1.35rem;
    line-height: 1.3;
    margin: 0 0 0.4rem;
  }
  .post-row-title a {
    color: hsl(var(--color-primary));
    text-decoration: none;
  }
  .post-row-title a:hover {
    color: hsl(var(--color-primary-200));
    text-decoration: underline;
    text-decoration-color: hsl(var(--color-accent-1));
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .post-row-external {
    font-size: 0.85em;
    vertical-align: baseline;
  }
  .post-row-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: hsl(var(--color-text) / 0.8);
    margin: 0;
    padding: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
</style>
