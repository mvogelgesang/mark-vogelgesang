---
import { getCollection } from "astro:content";
import PageWrapper from "../layouts/PageWrapper.astro";
import Chip from "../components/Chip.astro";
import PostRow from "../components/PostRow.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { formatDate } from "../utils/posts";

// Use getCollection to fetch all posts, and then sort them by date.
const posts = (await getCollection("blog")).sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const tagCounts = new Map();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const sortedTags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].toLowerCase().localeCompare(b[0].toLowerCase())
);
---

<PageWrapper title="Posts">
  <div class="w-full">
    <header class="page-header">
      <SectionTitle as="h1">All posts</SectionTitle>
      <p class="page-subtitle font-sans text-text">
        {posts.length} posts, newest first.
      </p>
    </header>

    <div class="blog-layout">
      <aside class="topics-rail">
        <p class="rail-label font-sans">Topics</p>
        <div class="rail-chips">
          {
            sortedTags.map(([tag, count]) => (
              <Chip href={`/tags/${tag}/`} icon="tag">
                {tag} · {count}
              </Chip>
            ))
          }
        </div>
      </aside>

      <div class="post-list">
        {
          posts.map((post) => (
            <PostRow
              url={
                post.data.externalUrl
                  ? post.data.externalUrl
                  : `/blog/${post.slug}`
              }
              title={post.data.title}
              description={post.data.description}
              date={formatDate(post.data.pubDate)}
              external={!!post.data.externalUrl}
            />
          ))
        }
      </div>
    </div>
  </div>
</PageWrapper>

<style>
  .page-header {
    margin: 2.5rem 0 1.5rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    margin: 0;
    padding: 0;
  }

  .blog-layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  .topics-rail {
    order: 2;
  }
  @media (min-width: 768px) {
    .blog-layout {
      display: grid;
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 3rem;
    }
    .topics-rail {
      order: 0;
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
  }

  .rail-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--color-secondary));
    margin: 0 0 0.75rem;
    padding: 0;
  }
  .rail-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
