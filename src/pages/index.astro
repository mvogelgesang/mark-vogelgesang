---
import { getCollection } from "astro:content";
import PageWrapper from "../layouts/PageWrapper.astro";
import MaterialIcon from "../components/MaterialIcon.astro";
import PostCard from "../components/PostCard.astro";
import Chip from "../components/Chip.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { formatDate } from "../utils/posts";

// Use getCollection to fetch all posts, and then sort them by date.
const posts = (await getCollection("blog")).sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const [latest, ...older] = posts;
const recent = older.slice(0, 4);

const tagCounts = new Map();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const topTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([tag]) => tag);

const postUrl = (post) =>
  post.data.externalUrl ? post.data.externalUrl : `/blog/${post.slug}`;
---

<PageWrapper title="Home">
  <div class="w-full">
    <!-- Hero -->
    <section class="hero rise">
      <p class="eyebrow font-sans">Mark Vogelgesang</p>
      <h1 class="hero-title text-primary-color">
        Pursuing <span class="gradient-text">better solutions</span>.
      </h1>
      <p class="hero-intro font-sans text-text">
        Director of Product Management at Salesforce. Here you'll find the
        occasional musing about my work, scripts to make life easier, and
        ongoing development projects.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-solid font-sans" href="/blog">
          Read the blog
          <MaterialIcon class="btn-icon" iconName="arrow_forward" />
        </a>
        <a class="btn btn-outline font-sans" href="/about">About me</a>
      </div>
    </section>

    <!-- Latest post -->
    {
      latest && (
        <section class="rise rise-1">
          <SectionTitle>Latest post</SectionTitle>
          <PostCard
            url={postUrl(latest)}
            title={latest.data.title}
            description={latest.data.description}
            date={formatDate(latest.data.pubDate)}
            tags={latest.data.tags}
            external={!!latest.data.externalUrl}
            featured
          />
        </section>
      )
    }

    <!-- Recent posts -->
    <section class="rise rise-2">
      <SectionTitle>More writing</SectionTitle>
      <div class="card-grid">
        {
          recent.map((post) => (
            <PostCard
              url={postUrl(post)}
              title={post.data.title}
              description={post.data.description}
              date={formatDate(post.data.pubDate)}
              external={!!post.data.externalUrl}
              clamp
            />
          ))
        }
      </div>
      <div class="view-all">
        <a class="view-all-link font-sans" href="/blog">
          View all posts
          <MaterialIcon class="btn-icon" iconName="arrow_forward" />
        </a>
      </div>
    </section>

    <!-- Topics -->
    <section class="topics rise rise-3">
      <SectionTitle>Browse by topic</SectionTitle>
      <div class="chip-row">
        {
          topTags.map((tag) => (
            <Chip href={`/tags/${tag}/`} icon="tag">
              {tag}
            </Chip>
          ))
        }
        <Chip href="/tags" muted>all topics</Chip>
      </div>
    </section>
  </div>
</PageWrapper>

<style>
  /* ---- Hero ---- */
  .hero {
    padding: 3.5rem 0 3rem;
  }
  .eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--color-secondary));
    padding: 0;
  }
  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 1.1;
    margin: 0.75rem 0 1rem;
  }
  .gradient-text {
    background: linear-gradient(
      90deg,
      hsl(var(--color-secondary)),
      hsl(var(--color-accent-1))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-intro {
    max-width: 38rem;
    font-size: 1.25rem;
    line-height: 1.7;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  /* ---- Buttons ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    padding: 0.65rem 1.4rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn-solid {
    background-color: hsl(var(--color-primary));
    color: hsl(var(--color-bg));
  }
  .btn-solid:hover {
    background-color: hsl(var(--color-primary-200));
  }
  .btn-outline {
    border: 2px solid hsl(var(--color-primary) / 0.4);
    color: hsl(var(--color-primary));
  }
  .btn-outline:hover {
    border-color: hsl(var(--color-accent-1));
  }
  .btn-icon {
    font-size: 1.1em;
  }

  /* ---- Sections ---- */
  section {
    margin-bottom: 3.5rem;
  }
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .view-all {
    margin-top: 1.5rem;
  }
  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: hsl(var(--color-primary));
    text-decoration: none;
  }
  .view-all-link:hover {
    color: hsl(var(--color-primary-200));
    text-decoration: underline;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .topics {
    margin-bottom: 2rem;
  }

  /* ---- Motion ---- */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .rise {
    animation: rise 0.6s ease-out both;
  }
  .rise-1 {
    animation-delay: 0.1s;
  }
  .rise-2 {
    animation-delay: 0.2s;
  }
  .rise-3 {
    animation-delay: 0.3s;
  }
  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
    }
    .btn:hover {
      transform: none;
    }
  }
</style>
