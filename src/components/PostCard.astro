---
import MaterialIcon from "./MaterialIcon.astro";
import Chip from "./Chip.astro";

const {
  url,
  title,
  description,
  date,
  tags = [],
  featured = false,
  clamp = false,
  external = false,
} = Astro.props;
---

<article class:list={["card", { "card-featured": featured }]}>
  {date && <p class="card-date font-sans">{date}</p>}
  <h3 class="card-title font-header">
    <a class="card-link" href={url}>
      {title}
      {
        external && (
          <MaterialIcon class="ml-2 align-middle" iconName="open_in_new" />
        )
      }
    </a>
  </h3>
  {
    description && (
      <p
        class:list={[
          "card-description font-sans text-text",
          { "card-clamp": clamp },
        ]}
      >
        {description}
      </p>
    )
  }
  {
    tags.length > 0 && (
      <div class="chip-row">
        {tags.map((tag) => (
          <Chip>{tag}</Chip>
        ))}
      </div>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid hsl(var(--color-text) / 0.15);
    border-radius: 0.75rem;
    padding: 1.5rem;
    background-color: hsl(var(--color-text) / 0.03);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: hsl(var(--color-accent-1) / 0.8);
    box-shadow: 0 12px 30px -12px hsl(var(--color-text) / 0.3);
  }
  .card-featured {
    border-left: 4px solid hsl(var(--color-accent-1));
  }
  .card-date {
    font-size: 0.875rem;
    color: hsl(var(--color-secondary));
    margin: 0;
    padding: 0 0 0.5rem;
  }
  .card-title {
    font-size: 1.35rem;
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }
  .card-featured .card-title {
    font-size: 1.75rem;
  }
  .card-link {
    color: hsl(var(--color-primary));
    text-decoration: none;
  }
  /* Stretch the title link across the whole card */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:hover .card-link {
    text-decoration: underline;
  }
  .card-description {
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
    padding: 0;
  }
  .card-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>
