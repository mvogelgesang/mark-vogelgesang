---
import MaterialIcon from "./MaterialIcon.astro";

const { url, title, description, date, external = false } = Astro.props;
---

<article class="post-row">
  <p class="post-row-date font-sans">{date}</p>
  <h2 class="post-row-title font-header">
    <a href={url}>
      {title}
      {external && <MaterialIcon class="post-row-external" iconName="open_in_new" />}
    </a>
  </h2>
  <p class="post-row-desc font-sans">{description}</p>
</article>

<style>
  .post-row {
    padding: 1.25rem 0;
    border-bottom: 1px solid hsl(var(--color-text) / 0.12);
  }
  .post-row:first-child {
    padding-top: 0;
  }
  .post-row-date {
    font-size: 0.85rem;
    color: hsl(var(--color-text) / 0.65);
    margin: 0 0 0.35rem;
    padding: 0;
  }
  .post-row-title {
    font-size: 1.35rem;
    line-height: 1.3;
    margin: 0 0 0.4rem;
  }
  .post-row-title a {
    color: hsl(var(--color-primary));
    text-decoration: none;
  }
  .post-row-title a:hover {
    color: hsl(var(--color-primary-200));
    text-decoration: underline;
    text-decoration-color: hsl(var(--color-accent-1));
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .post-row-external {
    font-size: 0.85em;
    vertical-align: baseline;
  }
  .post-row-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: hsl(var(--color-text) / 0.8);
    margin: 0;
    padding: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
</style>
